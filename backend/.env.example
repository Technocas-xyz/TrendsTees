# ---- Database ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trendstees_db
DB_USER=postgres
DB_PASSWORD=change_me

# ---- Website address(es) allowed to call this API (comma separated) ----
# Local: http://localhost:3000     Live: https://your-domain.com
FRONTEND_ORIGINS=http://localhost:3000
# true only when the site runs on https
COOKIE_SECURE=false

# ---- Database auto-setup on start (creates DB, tables, base data) ----
AUTO_DB_SETUP=true

# ---- First Super Admin (used once if no admin exists; remove the password afterwards) ----
ADMIN_NAME=Super Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- TeePublic demo designs: ONLY for a private testing server, never the live site ----
SEED_DEMO_DESIGNS=false
DEMO_DESIGNS_PATH=
